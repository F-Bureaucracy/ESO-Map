<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Title}}</title>
<style>{{.CSS}}</style>
</head>
<body>
<header class="bar">
  <div class="brand">
    <span class="logo" aria-hidden="true">◈</span>
    <div>
      <h1>ESO map</h1>
      <div class="root" id="root"></div>
    </div>
  </div>
  <div class="stats" id="stats"></div>
  <div class="controls">
    <input id="search" type="search" placeholder="Search paths, secrets, env vars…  ( / )" autocomplete="off" spellcheck="false">
    <select id="namespace" aria-label="Namespace filter"><option value="">All namespaces</option></select>
    <button id="diag-toggle" type="button" class="diag-btn"></button>
  </div>
</header>

<div class="legend" id="legend"></div>

<main id="viewport">
  <div id="canvas">
    <svg id="edges" aria-hidden="true">
      <defs id="markers"></defs>
    </svg>
  </div>
</main>

<aside id="details" hidden>
  <button type="button" class="close" id="details-close" aria-label="Close">×</button>
  <div id="details-body"></div>
</aside>

<aside id="diagnostics" hidden>
  <button type="button" class="close" id="diag-close" aria-label="Close">×</button>
  <h2>Diagnostics</h2>
  <ul id="diag-list"></ul>
</aside>

<script>const ESO_GRAPH = {{.Data}};</script>
<script>{{.JS}}</script>
</body>
</html>
